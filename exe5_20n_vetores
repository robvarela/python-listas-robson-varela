# exercício 5: Ler 20 números, separar em pares e ímpares, e imprimir as listas
numeros = []
par = []
impar = []

for i in range(20):
  num = int(input(f"Digite o {i+1}º número inteiro: "))
  numeros.append(num)

  # Verifica se o número é par utilizando o operador módulo (%)
  if num % 2 == 0:
    par.append(num)
  else:
    impar.append(num)

print("\n--- Resultados ---")
print("Lista completa de números:", numeros)
print("Vetor PAR:", par)
print("Vetor ÍMPAR:", impar)
